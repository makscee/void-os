{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["bun"],
    "noEmit": true,
    "isolatedModules": true
  },
  "include": ["src/**/*", "test/**/*", "build.ts"]
}
