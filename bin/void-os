#!/usr/bin/env bun
import { resolve, dirname } from "node:path"
import { existsSync } from "node:fs"
import { fileURLToPath } from "node:url"

const argv = process.argv.slice(2)
const cmd = argv[0]
const rest = argv.slice(1)

if (!cmd || cmd === "--help" || cmd === "-h") {
  console.log(`usage: void-os <command> [args]

commands:
  init      provision ~/void/ from vault-starter
  daemon    run the void-os daemon

flags:
  init --home <path>    override target vault dir
  init --dry-run        print actions without writing
  init --force          overwrite existing files
`)
  process.exit(cmd ? 0 : 1)
}

const here = dirname(fileURLToPath(import.meta.url))
const prefix = process.env.VOID_OS_PREFIX ?? resolve(here, "..")
const handler = resolve(prefix, "cli", `${cmd}.ts`)

if (!existsSync(handler)) {
  console.error(`void-os: unknown command "${cmd}"`)
  process.exit(2)
}

const mod = await import(handler)
await mod.default(rest, { prefix })
