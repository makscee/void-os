# Daemon state — re-created on every boot
.void/*
!.void/.gitkeep

# Obsidian local state
.obsidian/workspace*.json
.obsidian/cache
.obsidian/plugins/void-os/data.json

# Plugin build artifact — landed by `void-os init`, not tracked here
.obsidian/plugins/void-os/main.js
.obsidian/plugins/void-os/manifest.json
.obsidian/plugins/void-os/styles.css
